---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { siteIdentity } from "../data/site";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  period: string;
  projectType: string;
  deck: string;
  seoDescription: string;
  hero: ImageMetadata;
  heroAlt: string;
  heroCaption: string;
  socialImage: ImageMetadata;
  liveUrl?: string;
  liveLabel?: string;
}

const {
  title,
  period,
  projectType,
  deck,
  seoDescription,
  hero,
  heroAlt,
  heroCaption,
  socialImage,
  liveUrl,
  liveLabel = "visit live project ↗︎",
} = Astro.props;
const homeHref = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`${title} — ${siteIdentity.name}`}
  description={seoDescription}
  pageType="case"
  socialImage={socialImage.src}
>
  <main id="main-content" class="case-shell">
    <header class="case-header">
      <a class="back-link" href={homeHref}>← {siteIdentity.displayName}</a>
      <h1>{title}</h1>
      <p class="dateline">{period} · {projectType}</p>
      <p class="case-deck">{deck}</p>
      {liveUrl && (
        <p class="case-live-link">
          <a href={liveUrl} target="_blank" rel="noreferrer">{liveLabel}</a>
        </p>
      )}
    </header>

    <figure class="case-hero">
      <Picture
        src={hero}
        alt={heroAlt}
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 864px) calc(100vw - 64px), 800px"
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{heroCaption}</figcaption>
    </figure>

    <slot />
  </main>
</BaseLayout>
