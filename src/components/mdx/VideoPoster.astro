---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type MediaWidth = 'compact' | 'prose' | 'wide';

interface Props {
  href: string;
  src: ImageMetadata;
  alt: string;
  title?: string;
  caption?: string;
  label?: string;
  newTab?: boolean;
  width?: MediaWidth;
}

const {
  href,
  src,
  alt,
  title,
  caption,
  label = title ? `Open video: ${title}` : 'Open linked video',
  newTab = false,
  width = 'wide',
} = Astro.props;
---

<figure class:list={['video-poster', `video-poster--${width}`]}>
  <a
    class="video-poster__link"
    href={href}
    aria-label={label}
    target={newTab ? '_blank' : undefined}
    rel={newTab ? 'noreferrer' : undefined}
  >
    <Image
      src={src}
      alt={alt}
      width={src.width}
      height={src.height}
      loading="lazy"
      decoding="async"
    />
    {title && <span class="video-poster__title" aria-hidden="true">{title}</span>}
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
