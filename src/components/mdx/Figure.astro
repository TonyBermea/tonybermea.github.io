---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type MediaWidth = 'compact' | 'prose' | 'wide';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: MediaWidth;
  eager?: boolean;
}

const {
  src,
  alt,
  caption,
  width = 'prose',
  eager = false,
} = Astro.props;
---

<figure class:list={['mdx-figure', `mdx-figure--${width}`]}>
  <Image
    src={src}
    alt={alt}
    width={src.width}
    height={src.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
