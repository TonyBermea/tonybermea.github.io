---
import type { ImageMetadata } from "astro";

import LayerMixer, {
  type LayerDefinition,
} from "../islands/LayerMixer";

export interface Props {
  layers: LayerDefinition[];
  initialActive: string[];
  fallbackSrc: ImageMetadata;
  caption: string;
}

const { layers, initialActive, fallbackSrc, caption } = Astro.props;
---

<LayerMixer
  client:visible={{ rootMargin: "200px" }}
  {layers}
  {initialActive}
  {fallbackSrc}
  {caption}
/>
